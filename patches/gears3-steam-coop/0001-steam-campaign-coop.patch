+void SteamCallbackBridge::OnGameLobbyJoinRequested(GameLobbyJoinRequested_t *CallbackData)
+{
+	debugf(NAME_DevOnline,TEXT("Steam callback: OnGameLobbyJoinRequested lobby=%s"),*RenderCSteamID(CallbackData->m_steamIDLobby));
+	BeginSteamLobbyJoin(CallbackData->m_steamIDLobby);
+}
+
+void SteamCallbackBridge::OnLobbyCreated(LobbyCreated_t *CallbackData)
+{
+	GSteamLobbyCreatePending = FALSE;
+	if (CallbackData->m_eResult != k_EResultOK)
+	{
+		debugf(NAME_Error,TEXT("Steam lobby creation failed: %d"),(INT)CallbackData->m_eResult);
+		GPendingSteamLobbyInvites.Empty();
+		GShowSteamLobbyInviteUIWhenReady = FALSE;
+		return;
+	}
+
+	GSteamPartyLobby = CSteamID(CallbackData->m_ulSteamIDLobby);
+	PublishSteamPartyLobby(Subsystem);
+	for (INT Index = 0; Index < GPendingSteamLobbyInvites.Num(); Index++)
+	{
+		GSteamMatchmaking->InviteUserToLobby(GSteamPartyLobby,GPendingSteamLobbyInvites(Index));
+	}
+	GPendingSteamLobbyInvites.Empty();
+	if (GShowSteamLobbyInviteUIWhenReady)
+	{
+		GSteamFriends->ActivateGameOverlayInviteDialog(GSteamPartyLobby);
+		GShowSteamLobbyInviteUIWhenReady = FALSE;
+	}
+}
+
+void SteamCallbackBridge::OnLobbyEnter(LobbyEnter_t *CallbackData)
+{
+	const CSteamID Lobby(CallbackData->m_ulSteamIDLobby);
+	debugf(NAME_DevOnline,TEXT("Steam callback: OnLobbyEnter lobby=%s result=%u"),*RenderCSteamID(Lobby),CallbackData->m_EChatRoomEnterResponse);
+	if (CallbackData->m_EChatRoomEnterResponse != k_EChatRoomEnterResponseSuccess)
+	{
+		if (GPendingSteamLobbyJoin == Lobby)
+		{
+			GPendingSteamLobbyJoin = CSteamID();
+		}
+		return;
+	}
+
+	GSteamPartyLobby = Lobby;
+	if (GPendingSteamLobbyJoin == Lobby)
+	{
+		GPendingSteamLobbyJoin = CSteamID();
+		DispatchSteamLobbyInvite(Subsystem,Lobby);
+	}
+	else
+	{
+		PublishSteamPartyLobby(Subsystem);
+	}
+}
