+// Gears' menus expect platform party invites, but this Steam port originally
+// left SendGameInviteToFriend() and JoinFriendGame() as stubs. Keep one
+// friends-only Steam lobby alongside the existing UE3 party session. The lobby
+// carries the real UE3 connect URL and gives Steam a native invite/join object
+// without replacing Gears' own gameplay networking.
+static CSteamID GSteamPartyLobby;
+static CSteamID GPendingSteamLobbyJoin;
+static TArray<CSteamID> GPendingSteamLobbyInvites;
+static UBOOL GSteamLobbyCreatePending = FALSE;
+static UBOOL GShowSteamLobbyInviteUIWhenReady = FALSE;
+static const ANSICHAR* Gears3ConnectLobbyKey = "Gears3Connect";
+
+static UBOOL PublishSteamPartyLobby(UOnlineSubsystemSteamworks* Subsystem)
+{
+	if (GSteamMatchmaking == NULL || !GSteamPartyLobby.IsValid() || Subsystem == NULL)
+	{
+		return FALSE;
+	}
+
+	const FString Location = Subsystem->GetServerLocation();
+	FURL Url(NULL,*Location,TRAVEL_Absolute);
+	UBOOL bIsValid = FALSE;
+	FInternetIpAddr HostAddr;
+	HostAddr.SetIp(*Url.Host,bIsValid);
+	HostAddr.SetPort(Url.Port);
+	if (!bIsValid || Url.Port == 0)
+	{
+		debugf(NAME_Error,TEXT("Steam lobby: refusing invalid connect location '%s'"),*Location);
+		return FALSE;
+	}
+
+	DWORD IpAddr = 0;
+	HostAddr.GetIp(IpAddr);
+	const UBOOL bSetData = GSteamMatchmaking->SetLobbyData(GSteamPartyLobby,Gears3ConnectLobbyKey,TCHAR_TO_UTF8(*Location));
+	GSteamMatchmaking->SetLobbyGameServer(GSteamPartyLobby,(uint32)IpAddr,(uint16)Url.Port,CSteamID());
+	debugf(NAME_DevOnline,TEXT("Steam lobby %s published connect location %s"),*RenderCSteamID(GSteamPartyLobby),*Location);
+	return bSetData;
+}
+
+static UBOOL EnsureSteamPartyLobby(UOnlineSubsystemSteamworks* Subsystem)
+{
+	if (GSteamMatchmaking == NULL)
+	{
+		return FALSE;
+	}
+	if (GSteamPartyLobby.IsValid())
+	{
+		PublishSteamPartyLobby(Subsystem);
+		return TRUE;
+	}
+	if (!GSteamLobbyCreatePending)
+	{
+		INT MaxMembers = 4;
+		if (Subsystem && Subsystem->CachedGameInt && Subsystem->CachedGameInt->GameSettings)
+		{
+			MaxMembers = Max(2,Subsystem->CachedGameInt->GameSettings->NumPublicConnections + Subsystem->CachedGameInt->GameSettings->NumPrivateConnections);
+		}
+		GSteamLobbyCreatePending = TRUE;
+		GSteamMatchmaking->CreateLobby(k_ELobbyTypeFriendsOnly,MaxMembers);
+		debugf(NAME_DevOnline,TEXT("Creating Steam friends lobby for %d players"),MaxMembers);
+	}
+	return TRUE;
+}
+
+static UBOOL BeginSteamLobbyJoin(const CSteamID& Lobby)
+{
+	if (GSteamMatchmaking == NULL || !Lobby.IsValid())
+	{
+		return FALSE;
+	}
+	if (GSteamPartyLobby.IsValid() && GSteamPartyLobby != Lobby)
+	{
+		GSteamMatchmaking->LeaveLobby(GSteamPartyLobby);
+		GSteamPartyLobby = CSteamID();
+	}
+	GPendingSteamLobbyJoin = Lobby;
+	GSteamMatchmaking->JoinLobby(Lobby);
+	debugf(NAME_DevOnline,TEXT("Joining Steam lobby %s"),*RenderCSteamID(Lobby));
+	return TRUE;
+}
+
+static UBOOL DispatchSteamLobbyInvite(UOnlineSubsystemSteamworks* Subsystem,const CSteamID& Lobby)
+{
+	if (GSteamMatchmaking == NULL || Subsystem == NULL || Subsystem->CachedGameInt == NULL)
+	{
+		return FALSE;
+	}
+	const ANSICHAR* RawLocation = GSteamMatchmaking->GetLobbyData(Lobby,Gears3ConnectLobbyKey);
+	const FString Location = UTF8_TO_TCHAR(RawLocation ? RawLocation : "");
+	FURL Url(NULL,*Location,TRAVEL_Absolute);
+	UBOOL bIsValid = FALSE;
+	FInternetIpAddr HostAddr;
+	HostAddr.SetIp(*Url.Host,bIsValid);
+	HostAddr.SetPort(Url.Port);
+	if (!bIsValid || Url.Port == 0)
+	{
+		debugf(NAME_Error,TEXT("Steam lobby %s has invalid connect location '%s'"),*RenderCSteamID(Lobby),*Location);
+		return FALSE;
+	}
+
+	// Feed Steam's lobby address into the online-game interface that Gears already
+	// uses for platform invites. This fires GearPC.OnGameInviteAccepted(), which
+	// reserves a slot through the persistent-party beacon before any client travel.
+	// Direct SetClientTravel() skips that reservation and loses the guest when the
+	// host starts the campaign map.
+	UOnlineGameInterfaceSteamworks* GameInterface = Subsystem->CachedGameInt;
+	GameInterface->SetInviteInfo(*Location);
+	if (GameInterface->InviteGameSearch == NULL || GameInterface->InviteGameSearch->Results.Num() == 0)
+	{
+		debugf(NAME_Error,TEXT("Steam lobby %s could not create invite search data"),*RenderCSteamID(Lobby));
+		return FALSE;
+	}
+
+	FOnlineGameSearchResult& InviteResult = GameInterface->InviteGameSearch->Results(0);
+	const CSteamID LobbyOwner = GSteamMatchmaking->GetLobbyOwner(Lobby);
+	if (InviteResult.GameSettings != NULL && LobbyOwner.IsValid())
+	{
+		InviteResult.GameSettings->OwningPlayerId.Uid = (QWORD)LobbyOwner.ConvertToUint64();
+		if (GSteamFriends != NULL)
+		{
+			InviteResult.GameSettings->OwningPlayerName = UTF8_TO_TCHAR(GSteamFriends->GetFriendPersonaName(LobbyOwner));
+		}
+	}
+
+	OnlineGameInterfaceImpl_eventOnGameInviteAccepted_Parms Parms(EC_EventParm);
+	Parms.InviteResult = InviteResult;
+	debugf(NAME_DevOnline,TEXT("Steam lobby %s dispatching Gears party invite for %s (owner %s)"),
+		*RenderCSteamID(Lobby),*HostAddr.ToString(TRUE),*RenderCSteamID(LobbyOwner));
+	TriggerOnlineDelegates(GameInterface,GameInterface->GameInviteAcceptedDelegates,&Parms);
+	return TRUE;
+}
