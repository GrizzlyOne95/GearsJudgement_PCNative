  *
  * @param DeltaTime the amount of time that has passed since the last tick
  */
+// Gears' PC port never tells Steam which server the local player is on.
+// AdvertiseGame() does not exist in this 2011 SDK (SteamUser013); the equivalent is
+// InitiateGameConnection(), and the engine only drives that from the NMT_AuthServer
+// control message - which a listen host never receives, because it has no
+// ServerConnection. So for a host, Steam is never told anything, GetFriendGamePlayed()
+// returns m_unGameIP=0/m_usGamePort=0, and every friend running this build shows as
+// 0.0.0.0:0 on the MANAGE / INVITE screen. That one gap also disables Steam's own
+// "Join game" and leaves JoinFriendGame() with no address to travel to.
+//
+// Register the listen host's own address once a second so the already-complete
+// SteamCallbackBridge::OnGameServerChangeRequested() path has something to fire on.
+// Remote clients are left alone: NMT_AuthServer already registers them correctly.
+static DWORD GSteamAdvertisedIp = 0;
+static INT GSteamAdvertisedPort = 0;
+static QWORD GSteamAdvertisedServerId = 0;
+static FLOAT GSteamAdvertiseCountdown = 0.f;
+
+static void TickSteamAdvertiseListenHost(FLOAT DeltaTime)
+{
+	// Isolation switch: -NOSTEAMADVERTISE disables this entirely, so the rest of
+	// the build can be exercised without it.
+	static UBOOL bAdvertiseDisabled = ParseParam(appCmdLine(),TEXT("NOSTEAMADVERTISE"));
+	if (bAdvertiseDisabled)
+	{
+		return;
+	}
+
+	if (!GSteamworksInitialized || GSteamUser == NULL || GSocketSubsystem == NULL)
+	{
+		return;
+	}
+
+	GSteamAdvertiseCountdown -= DeltaTime;
+	if (GSteamAdvertiseCountdown > 0.f)
+	{
+		return;
+	}
+	GSteamAdvertiseCountdown = 1.0f;
+
+	DWORD Ip = 0;
+	INT Port = 0;
+
+	UNetDriver* NetDriver = (GWorld != NULL) ? GWorld->GetNetDriver() : NULL;
+	AWorldInfo* WorldInfo = (GWorld != NULL) ? GWorld->GetWorldInfo() : NULL;
+	if (NetDriver != NULL && NetDriver->ServerConnection == NULL && WorldInfo != NULL &&
+		WorldInfo->NetMode == NM_ListenServer)
+	{
+		// GetLocalHostAddr honours -MULTIHOME, which is what keeps this off a
+		// Hyper-V/WSL virtual switch on a machine that has one.
+		FInternetIpAddr LocalAddr;
+		GSocketSubsystem->GetLocalHostAddr(*GLog,LocalAddr);
+		LocalAddr.GetIp(Ip);
+		Port = GWorld->URL.Port != 0 ? GWorld->URL.Port : FURL::DefaultPort;
+	}
+
+	CSteamID ServerSteamID;
+	if (Ip != 0 && Port != 0)
+	{
+		// SteamGameServer_GetSteamID initially returns k_steamIDNotInitYetGS
+		// ([0:1]). Wait for the server login to complete instead of caching a
+		// presence update that Steam could not authenticate.
+		if (GSteamGameServer == NULL || !GSteamGameServer->BLoggedOn())
+		{
+			return;
+		}
+		ServerSteamID = GSteamGameServer->GetSteamID();
+		if (!ServerSteamID.IsValid())
+		{
+			return;
+		}
+	}
+
+	const QWORD ServerSteamIDValue = (QWORD)ServerSteamID.ConvertToUint64();
+	if (Ip == GSteamAdvertisedIp && Port == GSteamAdvertisedPort && ServerSteamIDValue == GSteamAdvertisedServerId)
+	{
+		return;
+	}
+
+	if (GSteamAdvertisedIp != 0 && GSteamAdvertisedPort != 0)
+	{
+		GSteamUser->TerminateGameConnection(GSteamAdvertisedIp,(uint16)GSteamAdvertisedPort);
+	}
+
+	GSteamAdvertisedIp = 0;
+	GSteamAdvertisedPort = 0;
+	GSteamAdvertisedServerId = 0;
+
+	if (Ip != 0 && Port != 0)
+	{
+		// The returned auth blob is deliberately discarded: a listen host authenticates
+		// itself through the game server interface already. The call is made for its
+		// side effect - it is what publishes the address to the Steam friends list.
+		BYTE AuthBlob[2048];
+		const INT AuthBlobSize = GSteamUser->InitiateGameConnection(AuthBlob,ARRAY_COUNT(AuthBlob),ServerSteamID,
+			Ip,(uint16)Port,appSteamGameServer_BSecure() != 0);
+		if (AuthBlobSize <= 0)
+		{
+			debugf(NAME_Error,TEXT("Failed to advertise listen host to Steam; will retry (server id %s)"),
+				*RenderCSteamID(ServerSteamID));
+			return;
+		}
+
+		GSteamAdvertisedIp = Ip;
+		GSteamAdvertisedPort = Port;
+		GSteamAdvertisedServerId = ServerSteamIDValue;
+
+		FInternetIpAddr LogAddr;
+		LogAddr.SetIp(Ip);
+		LogAddr.SetPort(Port);
+		debugf(NAME_DevOnline,TEXT("Advertised listen host %s to Steam (server id %s, auth bytes %d)"),
+			*LogAddr.ToString(TRUE),*RenderCSteamID(ServerSteamID),AuthBlobSize);
+	}
+	else
+	{
+		debugf(NAME_DevOnline,TEXT("Cleared advertised game server with Steam"));
+	}
+}
